<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="Unpwn.App.MainWindow"
        mc:Ignorable="d"
        d:DesignWidth="1080"
        d:DesignHeight="760"
        Title="unpwn"
        Width="1080"
        Height="760"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
    <Border Padding="24,18" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="unpwn" />
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="40,32" MaxWidth="920" HorizontalAlignment="Center" Spacing="20">
        <TextBlock FontSize="32" FontWeight="SemiBold" Text="Import account inventory" />
        <TextBlock FontSize="16"
                   TextWrapping="Wrap"
                   Text="Import account names and login identifiers from a CSV file. Old passwords are never imported or saved." />

        <Border Padding="18" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
          <StackPanel Spacing="14">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="1. Select source" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button x:Name="OpenCsvButton" Click="OpenCsvButton_OnClick" Content="Choose CSV file" />
              <TextBlock x:Name="SelectedFileText"
                         VerticalAlignment="Center"
                         Text="No file selected"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border x:Name="PasswordWarningBorder"
                    IsVisible="False"
                    Padding="14"
                    CornerRadius="6"
                    Background="{DynamicResource SystemControlBackgroundAccentBrush}">
              <StackPanel Spacing="10">
                <TextBlock x:Name="PasswordWarningText"
                           Foreground="{DynamicResource SystemControlForegroundChromeWhiteBrush}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <CheckBox x:Name="ExcludePasswordsCheckBox"
                          Foreground="{DynamicResource SystemControlForegroundChromeWhiteBrush}"
                          Content="Exclude all detected password columns from this import"
                          IsCheckedChanged="ExcludePasswordsCheckBox_OnIsCheckedChanged" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Padding="18" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
          <StackPanel Spacing="14">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="2. Map columns" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="12">
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
                <TextBlock Text="Service name" />
                <ComboBox x:Name="ServiceNameColumnCombo" SelectionChanged="MappingCombo_OnSelectionChanged" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5">
                <TextBlock Text="Account name" />
                <ComboBox x:Name="AccountNameColumnCombo" SelectionChanged="MappingCombo_OnSelectionChanged" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                <TextBlock Text="Username or email" />
                <ComboBox x:Name="LoginIdentifierColumnCombo" SelectionChanged="MappingCombo_OnSelectionChanged" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                <TextBlock Text="Account URL" />
                <ComboBox x:Name="AccountUrlColumnCombo" SelectionChanged="MappingCombo_OnSelectionChanged" />
              </StackPanel>
            </Grid>
            <Button x:Name="CreatePreviewButton"
                    HorizontalAlignment="Left"
                    IsEnabled="False"
                    Click="CreatePreviewButton_OnClick"
                    Content="Create import preview" />
          </StackPanel>
        </Border>

        <Border Padding="18" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
          <StackPanel Spacing="12">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="3. Review preview" />
            <ItemsControl x:Name="DiagnosticsItems" />
            <ListBox x:Name="PreviewItems" MinHeight="90" MaxHeight="260" />
            <TextBlock x:Name="PreviewSummaryText"
                       Text="Select a CSV file and create a preview."
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Padding="14" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAccentBrush}">
          <TextBlock Foreground="{DynamicResource SystemControlForegroundChromeWhiteBrush}"
                     TextWrapping="Wrap"
                     Text="Use unpwn only on a trusted device. This application does not detect or remove malware." />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
