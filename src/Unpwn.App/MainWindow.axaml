<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Unpwn.App.Presentation"
        xmlns:views="using:Unpwn.App.Views"
        x:Class="Unpwn.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1080"
        d:DesignHeight="720"
        Title="{DynamicResource App.WindowTitle}"
        Width="1080"
        Height="720"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
    <Border Grid.Row="0"
            Padding="20,14"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="24">
        <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Text="unpwn" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock FontWeight="SemiBold" Text="{Binding VaultContextLabel}" />
          <TextBlock FontSize="12" Opacity="0.75" Text="{Binding SessionContextLabel}" />
        </StackPanel>
        <StackPanel Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
          <TextBlock VerticalAlignment="Center"
                     Text="{DynamicResource Shell.Language.Label}" />
          <ComboBox Width="120"
                    TabIndex="0"
                    AutomationProperties.AutomationId="shell-language"
                    AutomationProperties.Name="{DynamicResource Shell.Language.Label}"
                    ItemsSource="{Binding LanguageOptions}"
                    SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LanguageOptionViewModel">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button TabIndex="1"
                  AutomationProperties.AutomationId="shell-lock-vault"
                  IsVisible="{Binding IsVaultUnlocked}"
                  Command="{Binding LockCommand}"
                  Content="{DynamicResource Shell.Lock.Button}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="220,*" RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0"
              Grid.RowSpan="3"
              Grid.Column="0"
              Padding="12"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="0,0,1,0"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Margin="10,6,10,12"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Opacity="0.75"
                     Text="{DynamicResource Shell.WorkspaceHeading}" />
          <ListBox Grid.Row="1"
                   TabIndex="2"
                   AutomationProperties.AutomationId="shell-navigation"
                   AutomationProperties.Name="{DynamicResource Shell.WorkspaceHeading}"
                   ItemsSource="{Binding NavigationItems}"
                   SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="IsEnabled" Value="{ReflectionBinding IsEnabled}" />
              </Style>
              <Style Selector="ListBoxItem:disabled">
                <Setter Property="Opacity" Value="0.42" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavigationItemViewModel">
                <Grid Margin="2,4"
                      ColumnDefinitions="32,*"
                      ColumnSpacing="8">
                  <Border Width="28"
                          Height="28"
                          VerticalAlignment="Center"
                          CornerRadius="14"
                          Background="{DynamicResource SystemControlBackgroundAccentBrush}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundChromeWhiteBrush}"
                               FontWeight="Bold"
                               Text="{Binding Symbol}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                    <TextBlock FontSize="11"
                               Opacity="0.72"
                               Text="{Binding Description}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <StackPanel Grid.Row="0" Grid.Column="1">
        <Border IsVisible="{Binding HasStartupRecoveryWarning}"
                AutomationProperties.AutomationId="shell-startup-recovery-warning"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="{DynamicResource Shell.Recovery.Message}"
                Padding="20,12"
                BorderBrush="{DynamicResource SystemControlErrorTextForegroundBrush}"
                BorderThickness="0,0,0,2">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <TextBlock FontSize="20"
                       FontWeight="Bold"
                       Text="{DynamicResource Shell.Recovery.Symbol}" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock FontWeight="SemiBold"
                         Text="{DynamicResource Shell.Recovery.Title}" />
              <TextBlock Text="{DynamicResource Shell.Recovery.Message}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2"
                    AutomationProperties.AutomationId="shell-dismiss-recovery-warning"
                    VerticalAlignment="Center"
                    Command="{Binding DismissStartupRecoveryCommand}"
                    Content="{DynamicResource Shell.Recovery.Dismiss}" />
          </Grid>
        </Border>

        <Border IsVisible="{Binding IsPersistenceStatusVisible}"
                AutomationProperties.AutomationId="shell-persistence-status"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="{Binding PersistenceStatusText}"
                Padding="20,10"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock FontWeight="Bold" Text="{Binding PersistenceStatusSymbol}" />
            <TextBlock FontWeight="SemiBold"
                       Text="{Binding PersistenceStatusText}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding IsGuidedWizardVisible}"
                AutomationProperties.AutomationId="shell-guided-status"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="{Binding GuidedRecommendationText}"
                Padding="20,12"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource SystemControlBackgroundChromeLowBrush}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="3">
              <TextBlock FontSize="12"
                         FontWeight="SemiBold"
                         Text="{DynamicResource Shell.Guided.Heading}" />
              <TextBlock FontWeight="SemiBold" Text="{Binding GuidedStepText}" />
              <TextBlock Opacity="0.78"
                         Text="{Binding GuidedRecommendationText}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
              <Button Command="{Binding GuidedBackCommand}"
                      Content="{DynamicResource Shell.Guided.Back}" />
              <Button Command="{Binding GuidedOpenCommand}"
                      Content="{DynamicResource Shell.Guided.Open}" />
              <Button Command="{Binding GuidedAdvanceCommand}"
                      Content="{DynamicResource Shell.Guided.Continue}" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>

      <ScrollViewer Grid.Row="1" Grid.Column="1" TabIndex="3">
        <ContentControl Margin="28,24"
                        MaxWidth="900"
                        HorizontalAlignment="Stretch"
                        Content="{Binding CurrentScreen}" />
      </ScrollViewer>

      <Border Grid.Row="2"
              Grid.Column="1"
              Padding="20,12"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="0,1,0,0"
              Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <views:StatusBannerView DataContext="{Binding CurrentStatus}" />
      </Border>
    </Grid>
  </Grid>
</Window>
