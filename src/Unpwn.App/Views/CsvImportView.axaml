<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Unpwn.App.Presentation"
             xmlns:views="using:Unpwn.App.Views"
             x:Class="Unpwn.App.Views.CsvImportView"
             x:DataType="vm:CsvImportScreenViewModel">
  <StackPanel Spacing="20">
    <StackPanel Spacing="8">
      <TextBlock Classes="page-title" Text="{Binding Title}" />
      <TextBlock FontSize="16" Text="{Binding Description}" TextWrapping="Wrap" />
    </StackPanel>

    <views:StatusBannerView DataContext="{Binding Status}" />

    <Border Padding="18" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Spacing="14">
        <TextBlock Classes="section-title" Text="{DynamicResource Import.Step.Source}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="OpenCsvButton"
                  TabIndex="4"
                  Click="OpenCsvButton_OnClick"
                  Content="{DynamicResource Import.ChooseFile.Button}" />
          <TextBlock x:Name="SelectedFileText"
                     VerticalAlignment="Center"
                     Text="{DynamicResource Import.NoFile}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border x:Name="PasswordWarningBorder"
                IsVisible="False"
                Padding="14"
                BorderBrush="#B26A00"
                BorderThickness="5,1,1,1"
                CornerRadius="6">
          <StackPanel Spacing="10">
            <TextBlock x:Name="PasswordWarningText"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <CheckBox x:Name="ExcludePasswordsCheckBox"
                      TabIndex="5"
                      Content="{DynamicResource Import.Password.Exclude}"
                      IsCheckedChanged="ExcludePasswordsCheckBox_OnIsCheckedChanged" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border Padding="18" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Spacing="14">
        <TextBlock Classes="section-title" Text="{DynamicResource Import.Step.Mapping}" />
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="12">
          <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
            <TextBlock Text="{DynamicResource Import.Mapping.Service}" />
            <ComboBox x:Name="ServiceNameColumnCombo"
                      TabIndex="6"
                      SelectionChanged="MappingCombo_OnSelectionChanged" />
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5">
            <TextBlock Text="{DynamicResource Import.Mapping.Account}" />
            <ComboBox x:Name="AccountNameColumnCombo"
                      TabIndex="7"
                      SelectionChanged="MappingCombo_OnSelectionChanged" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
            <TextBlock Text="{DynamicResource Import.Mapping.Login}" />
            <ComboBox x:Name="LoginIdentifierColumnCombo"
                      TabIndex="8"
                      SelectionChanged="MappingCombo_OnSelectionChanged" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
            <TextBlock Text="{DynamicResource Import.Mapping.Url}" />
            <ComboBox x:Name="AccountUrlColumnCombo"
                      TabIndex="9"
                      SelectionChanged="MappingCombo_OnSelectionChanged" />
          </StackPanel>
        </Grid>
        <Button x:Name="CreatePreviewButton"
                TabIndex="10"
                HorizontalAlignment="Left"
                IsEnabled="False"
                Click="CreatePreviewButton_OnClick"
                Content="{DynamicResource Import.Preview.Create}" />
      </StackPanel>
    </Border>

    <Border Padding="18" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Spacing="12">
        <TextBlock Classes="section-title" Text="{DynamicResource Import.Step.Review}" />
        <ItemsControl x:Name="DiagnosticsItems" />
        <ListBox x:Name="PreviewItems" MinHeight="90" MaxHeight="260" />
        <TextBlock x:Name="PreviewSummaryText"
                   Text="{DynamicResource Import.Preview.Initial}"
                   TextWrapping="Wrap" />
        <StackPanel x:Name="DuplicateResolutionPanel" IsVisible="False" Spacing="6">
          <TextBlock Text="{DynamicResource Import.Resolution.Label}" FontWeight="SemiBold" />
          <ComboBox x:Name="DuplicateResolutionCombo"
                    SelectionChanged="DuplicateResolutionCombo_OnSelectionChanged" />
        </StackPanel>
        <Button x:Name="ImportReviewedButton"
                HorizontalAlignment="Left"
                IsEnabled="False"
                Click="ImportReviewedButton_OnClick"
                Content="{DynamicResource Import.Action.Import}" />
        <TextBlock x:Name="ImportResultText" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
