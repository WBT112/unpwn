<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Unpwn.App.Presentation"
             xmlns:views="using:Unpwn.App.Views"
             x:Class="Unpwn.App.Views.CsvImportView"
             x:DataType="vm:CsvImportScreenViewModel">
  <StackPanel Spacing="20">
    <StackPanel Spacing="8">
      <TextBlock Classes="page-title" Text="{Binding Title}" />
      <TextBlock FontSize="16" Text="{Binding Description}" TextWrapping="Wrap" />
    </StackPanel>

    <views:StatusBannerView DataContext="{Binding Status}" />

    <Border Padding="18" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Spacing="14">
        <TextBlock Classes="section-title" Text="{DynamicResource Import.Step.Source}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="OpenCsvButton"
                  Classes="initial-focus"
                  AutomationProperties.AutomationId="import-open-csv"
                  TabIndex="4"
                  Click="OpenCsvButton_OnClick"
                  Content="{DynamicResource Import.ChooseFile.Button}" />
          <TextBlock x:Name="SelectedFileText"
                     VerticalAlignment="Center"
                     Text="{DynamicResource Import.NoFile}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border x:Name="PasswordWarningBorder"
                Classes="focus-on-visible"
                IsVisible="False"
                Focusable="True"
                AutomationProperties.AutomationId="import-password-warning"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="{Binding #PasswordWarningText.Text}"
                Padding="14"
                BorderBrush="{DynamicResource SystemControlErrorTextForegroundBrush}"
                BorderThickness="5,1,1,1"
                CornerRadius="6">
          <TextBlock x:Name="PasswordWarningText"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </Border>

    <Border x:Name="MappingPanel"
            AutomationProperties.AutomationId="import-mapping-panel"
            IsVisible="False"
            Padding="18"
            CornerRadius="8"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Spacing="14">
        <TextBlock Classes="section-title" Text="{DynamicResource Import.Step.Mapping}" />
        <TextBlock x:Name="MappingIssuesText"
                   Focusable="True"
                   AutomationProperties.AutomationId="import-mapping-issues"
                   AutomationProperties.LiveSetting="Assertive"
                   TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="12">
          <StackPanel x:Name="ServiceNameMappingField"
                      AutomationProperties.AutomationId="import-service-mapping-field"
                      Grid.Row="0" Grid.Column="0" Spacing="5">
            <TextBlock Text="{DynamicResource Import.Mapping.Service}" />
            <ComboBox x:Name="ServiceNameColumnCombo"
                      AutomationProperties.AutomationId="import-service-column"
                      AutomationProperties.Name="{DynamicResource Import.Mapping.Service}"
                      TabIndex="5"
                      SelectionChanged="MappingCombo_OnSelectionChanged" />
          </StackPanel>
          <StackPanel x:Name="AccountNameMappingField"
                      AutomationProperties.AutomationId="import-account-mapping-field"
                      Grid.Row="0" Grid.Column="1" Spacing="5">
            <TextBlock Text="{DynamicResource Import.Mapping.Account}" />
            <ComboBox x:Name="AccountNameColumnCombo"
                      AutomationProperties.AutomationId="import-account-column"
                      AutomationProperties.Name="{DynamicResource Import.Mapping.Account}"
                      TabIndex="6"
                      SelectionChanged="MappingCombo_OnSelectionChanged" />
          </StackPanel>
          <StackPanel x:Name="LoginIdentifierMappingField"
                      AutomationProperties.AutomationId="import-login-mapping-field"
                      Grid.Row="1" Grid.Column="0" Spacing="5">
            <TextBlock Text="{DynamicResource Import.Mapping.Login}" />
            <ComboBox x:Name="LoginIdentifierColumnCombo"
                      AutomationProperties.AutomationId="import-login-column"
                      AutomationProperties.Name="{DynamicResource Import.Mapping.Login}"
                      TabIndex="7"
                      SelectionChanged="MappingCombo_OnSelectionChanged" />
          </StackPanel>
          <StackPanel x:Name="AccountUrlMappingField"
                      AutomationProperties.AutomationId="import-url-mapping-field"
                      Grid.Row="1" Grid.Column="1" Spacing="5">
            <TextBlock Text="{DynamicResource Import.Mapping.Url}" />
            <ComboBox x:Name="AccountUrlColumnCombo"
                      AutomationProperties.AutomationId="import-url-column"
                      AutomationProperties.Name="{DynamicResource Import.Mapping.Url}"
                      TabIndex="8"
                      SelectionChanged="MappingCombo_OnSelectionChanged" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border Padding="18" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Spacing="12">
        <TextBlock Classes="section-title" Text="{DynamicResource Import.Step.Review}" />
        <ItemsControl x:Name="DiagnosticsItems"
                      Focusable="True"
                      AutomationProperties.AutomationId="import-diagnostics"
                      AutomationProperties.LiveSetting="Assertive" />
        <ListBox x:Name="PreviewItems"
                 AutomationProperties.AutomationId="import-preview-items"
                 MinHeight="90"
                 MaxHeight="260" />
        <TextBlock x:Name="PreviewSummaryText"
                   Focusable="True"
                   AutomationProperties.AutomationId="import-preview-summary"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="{Binding #PreviewSummaryText.Text}"
                   Text="{DynamicResource Import.Preview.Initial}"
                   TextWrapping="Wrap" />
        <StackPanel x:Name="DuplicateResolutionPanel" IsVisible="False" Spacing="6">
          <TextBlock Text="{DynamicResource Import.Resolution.Label}" FontWeight="SemiBold" />
          <ComboBox x:Name="DuplicateResolutionCombo"
                    AutomationProperties.AutomationId="import-duplicate-resolution"
                    AutomationProperties.Name="{DynamicResource Import.Resolution.Label}"
                    SelectionChanged="DuplicateResolutionCombo_OnSelectionChanged" />
        </StackPanel>
        <Button x:Name="ImportReviewedButton"
                AutomationProperties.AutomationId="import-reviewed"
                HorizontalAlignment="Left"
                IsEnabled="False"
                Click="ImportReviewedButton_OnClick"
                Content="{DynamicResource Import.Action.Import}" />
        <TextBlock x:Name="ImportResultText"
                   Focusable="True"
                   AutomationProperties.AutomationId="import-result"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name="{Binding #ImportResultText.Text}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
