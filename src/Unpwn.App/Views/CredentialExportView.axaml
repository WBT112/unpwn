<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Unpwn.App.Presentation"
             xmlns:views="using:Unpwn.App.Views"
             x:Class="Unpwn.App.Views.CredentialExportView"
             x:DataType="vm:CredentialExportScreenViewModel">
  <StackPanel Spacing="20">
    <StackPanel Spacing="8">
      <TextBlock Classes="page-title" Text="{Binding Title}" />
      <TextBlock FontSize="16" Text="{Binding Description}" TextWrapping="Wrap" />
    </StackPanel>
    <views:StatusBannerView DataContext="{Binding Status}" />

    <Border Classes="focus-on-visible actionable-warning" IsVisible="{Binding HasResult}"
            Focusable="True" AutomationProperties.AutomationId="credentials-result"
            AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding ResultMessage}">
      <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" />
    </Border>

    <Border Padding="20" CornerRadius="10"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Spacing="12">
        <TextBlock Classes="section-title" Text="{DynamicResource Credentials.Flow.Title}" />
        <TextBlock Text="{DynamicResource Credentials.Flow.Help}" TextWrapping="Wrap" />
        <TextBlock IsVisible="{Binding !HasCredentials}" Text="{DynamicResource Credentials.List.Empty}" TextWrapping="Wrap" />
        <ListBox Classes="initial-focus"
                 AutomationProperties.AutomationId="credentials-handoff-list"
                 ItemsSource="{Binding Credentials}" SelectedItem="{Binding SelectedCredential, Mode=TwoWay}"
                 MaxHeight="280">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GeneratedCredentialListItemViewModel">
              <Grid Margin="4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <CheckBox IsEnabled="{Binding CanExport}" IsChecked="{Binding IsSelectedForExport, Mode=TwoWay}" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock FontWeight="SemiBold" Text="{Binding AccountLabel}" TextWrapping="Wrap" />
                  <TextBlock FontSize="12" Text="{Binding StageLabel}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{DynamicResource Credentials.Secret.Concealed}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding IsSecretRevealed}" Classes="actionable-warning"
            AutomationProperties.AutomationId="credentials-revealed-secret"
            AutomationProperties.LiveSetting="Assertive"
            AutomationProperties.Name="{DynamicResource Credentials.Secret.RevealedAnnouncement}">
      <TextBlock FontFamily="Monospace" Text="{Binding RevealedSecret}" TextWrapping="Wrap" />
    </Border>
    <TextBlock IsVisible="{Binding IsClipboardCountdownVisible}"
               AutomationProperties.AutomationId="credentials-clipboard-countdown"
               AutomationProperties.LiveSetting="Polite"
               AutomationProperties.Name="{Binding ClipboardCountdownText}"
               Text="{Binding ClipboardCountdownText}" TextWrapping="Wrap" />

    <Border IsVisible="{Binding SelectedCredentialNeedsUse}" Classes="passive-information"
            AutomationProperties.AutomationId="credentials-stage-use">
      <StackPanel Spacing="10">
        <TextBlock Classes="section-title" Text="{DynamicResource Credentials.Flow.UseTitle}" />
        <TextBlock Text="{Binding SelectedCredentialStage}" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource Credentials.Flow.UseHelp}" TextWrapping="Wrap" />
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Classes="secondary" Content="{DynamicResource Credentials.Secret.Reveal}" Command="{Binding RevealCommand}" />
          <Button Classes="secondary" Content="{DynamicResource Credentials.Secret.Hide}" Command="{Binding HideCommand}" />
          <Button Classes="secondary" Content="{DynamicResource Credentials.Secret.Copy}" Command="{Binding CopyCommand}" />
          <Button Classes="primary" Content="{DynamicResource Credentials.Lifecycle.MarkUsed}" Command="{Binding MarkUsedCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding SelectedCredentialNeedsConfirmation}" Classes="passive-information"
            AutomationProperties.AutomationId="credentials-stage-confirm">
      <StackPanel Spacing="10">
        <TextBlock Classes="section-title" Text="{DynamicResource Credentials.Flow.ConfirmTitle}" />
        <TextBlock Text="{DynamicResource Credentials.Flow.ConfirmHelp}" TextWrapping="Wrap" />
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Classes="secondary" Content="{DynamicResource Credentials.Secret.Reveal}" Command="{Binding RevealCommand}" />
          <Button Classes="secondary" Content="{DynamicResource Credentials.Secret.Copy}" Command="{Binding CopyCommand}" />
          <Button Classes="primary" Content="{DynamicResource Credentials.Lifecycle.Confirm}" Command="{Binding ConfirmCredentialCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding HasCredentialsReadyForExport}" Classes="passive-information"
            AutomationProperties.AutomationId="credentials-stage-export">
      <StackPanel Spacing="12">
        <TextBlock Classes="section-title" Text="{DynamicResource Credentials.Export.Title}" />
        <TextBlock Text="{DynamicResource Credentials.Export.Help}" TextWrapping="Wrap" />
        <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:CredentialExportFormatOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBox Text="{Binding DestinationPath, Mode=TwoWay}"
                   PlaceholderText="{DynamicResource Credentials.Export.DestinationPlaceholder}" />
          <Button Grid.Column="1" Classes="secondary"
                  Content="{DynamicResource Credentials.Export.ChooseDestination}"
                  Click="ChooseDestinationButton_OnClick" />
        </Grid>
        <Border IsVisible="{Binding HasExportDestination}" Classes="actionable-warning">
          <StackPanel Spacing="8">
            <TextBlock Text="{DynamicResource Credentials.Export.Warning}" TextWrapping="Wrap" />
            <CheckBox Content="{DynamicResource Credentials.Export.AcknowledgeRisk}"
                      IsChecked="{Binding PlaintextRiskAcknowledged, Mode=TwoWay}" />
          </StackPanel>
        </Border>
        <Button Classes="primary" HorizontalAlignment="Left"
                Content="{DynamicResource Credentials.Export.Action}" Command="{Binding ExportCommand}" />
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding SelectedCredentialAwaitsImportConfirmation}" Classes="passive-information"
            AutomationProperties.AutomationId="credentials-stage-import-confirmation">
      <StackPanel Spacing="10">
        <TextBlock Classes="section-title" Text="{DynamicResource Credentials.Handoff.Title}" />
        <TextBlock Text="{DynamicResource Credentials.Handoff.Help}" TextWrapping="Wrap" />
        <TextBlock IsVisible="{Binding IsImportConfirmationPostponed}"
                   Text="{DynamicResource Credentials.Handoff.PostponedVisible}" TextWrapping="Wrap" />
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Classes="primary" Content="{DynamicResource Credentials.Handoff.ConfirmImport}"
                  Command="{Binding ConfirmImportCommand}" />
          <Button Classes="tertiary" Content="{DynamicResource Credentials.Handoff.Postpone}"
                  Command="{Binding PostponeImportConfirmationCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding SelectedCredentialAwaitsCleanup}" Classes="actionable-warning"
            AutomationProperties.AutomationId="credentials-stage-cleanup">
      <StackPanel Spacing="10">
        <TextBlock Classes="section-title" Text="{DynamicResource Credentials.Flow.CleanupTitle}" />
        <TextBlock Text="{DynamicResource Credentials.Handoff.CleanupPending}" TextWrapping="Wrap" />
        <Button Classes="primary" HorizontalAlignment="Left"
                Content="{DynamicResource Credentials.Handoff.ConfirmCleanup}"
                Command="{Binding ConfirmCleanupCommand}" />
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding SelectedCredentialCanBeRemoved}" Classes="passive-information"
            AutomationProperties.AutomationId="credentials-stage-remove-copy">
      <StackPanel Spacing="10">
        <TextBlock Classes="section-title" Text="{DynamicResource Credentials.Delete.Title}" />
        <TextBlock Text="{DynamicResource Credentials.Delete.Disclaimer}" TextWrapping="Wrap" />
        <Button Classes="destructive" HorizontalAlignment="Left"
                Content="{DynamicResource Credentials.Delete.Action}" Command="{Binding DeleteCommand}" />
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding IsCompletionContinuationVisible}" Classes="passive-information">
      <StackPanel Spacing="10">
        <TextBlock Classes="section-title" Text="{DynamicResource Credentials.Continue.Title}" />
        <TextBlock Text="{DynamicResource Credentials.Continue.Message}" TextWrapping="Wrap" />
        <Button Classes="primary" AutomationProperties.AutomationId="credentials-continue-completion"
                HorizontalAlignment="Left" Content="{DynamicResource Credentials.Continue.Action}"
                Command="{Binding ContinueToCompletionCommand}" />
      </StackPanel>
    </Border>

    <Expander Classes="details" AutomationProperties.AutomationId="credentials-advanced"
              Header="{DynamicResource Credentials.Advanced.Title}">
      <StackPanel Margin="0,12,0,0" Spacing="14">
        <TextBlock Text="{DynamicResource Credentials.Advanced.Help}" TextWrapping="Wrap" />
        <TextBlock FontWeight="SemiBold" Text="{DynamicResource Credentials.Generate.Account}" />
        <ComboBox AutomationProperties.AutomationId="credentials-account"
                  ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:CredentialAccountOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <TextBlock VerticalAlignment="Center" Text="{DynamicResource Credentials.Generate.Length}" />
          <NumericUpDown Grid.Column="1" Minimum="12" Maximum="128" Value="{Binding PasswordLength, Mode=TwoWay}" />
        </Grid>
        <WrapPanel ItemSpacing="12" LineSpacing="8">
          <CheckBox Content="{DynamicResource Credentials.Generate.Lowercase}" IsChecked="{Binding IncludeLowercase, Mode=TwoWay}" />
          <CheckBox Content="{DynamicResource Credentials.Generate.Uppercase}" IsChecked="{Binding IncludeUppercase, Mode=TwoWay}" />
          <CheckBox Content="{DynamicResource Credentials.Generate.Digits}" IsChecked="{Binding IncludeDigits, Mode=TwoWay}" />
          <CheckBox Content="{DynamicResource Credentials.Generate.Symbols}" IsChecked="{Binding IncludeSymbols, Mode=TwoWay}" />
        </WrapPanel>
        <Button Classes="secondary" HorizontalAlignment="Left"
                Content="{DynamicResource Credentials.Generate.Action}" Command="{Binding GenerateCommand}" />
        <Button Classes="tertiary" IsVisible="{Binding IsImportConfirmed}"
                Content="{DynamicResource Credentials.Handoff.RevokeImport}"
                Command="{Binding RevokeImportConfirmationCommand}" />
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
