<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Unpwn.App.Presentation"
             xmlns:views="using:Unpwn.App.Views"
             x:Class="Unpwn.App.Views.CredentialExportView"
             x:DataType="vm:CredentialExportScreenViewModel">
  <StackPanel Spacing="20">
    <StackPanel Spacing="8">
      <TextBlock Classes="page-title" Text="{Binding Title}" />
      <TextBlock FontSize="16" Text="{Binding Description}" TextWrapping="Wrap" />
    </StackPanel>

    <views:StatusBannerView DataContext="{Binding Status}" />

    <Border IsVisible="{Binding HasResult}"
            Padding="14"
            CornerRadius="8"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" />
    </Border>

    <Border Padding="18" CornerRadius="10"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Spacing="12">
        <TextBlock Classes="section-title" Text="{DynamicResource Credentials.Generate.Title}" />
        <TextBlock Text="{DynamicResource Credentials.Generate.Help}" TextWrapping="Wrap" />
        <TextBlock FontWeight="SemiBold" Text="{DynamicResource Credentials.Generate.Account}" />
        <ComboBox ItemsSource="{Binding Accounts}"
                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CredentialAccountOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <TextBlock VerticalAlignment="Center" Text="{DynamicResource Credentials.Generate.Length}" />
          <NumericUpDown Grid.Column="1"
                         Minimum="12"
                         Maximum="128"
                         Value="{Binding PasswordLength, Mode=TwoWay}" />
        </Grid>
        <WrapPanel ItemSpacing="12" LineSpacing="8">
          <CheckBox Content="{DynamicResource Credentials.Generate.Lowercase}"
                    IsChecked="{Binding IncludeLowercase, Mode=TwoWay}" />
          <CheckBox Content="{DynamicResource Credentials.Generate.Uppercase}"
                    IsChecked="{Binding IncludeUppercase, Mode=TwoWay}" />
          <CheckBox Content="{DynamicResource Credentials.Generate.Digits}"
                    IsChecked="{Binding IncludeDigits, Mode=TwoWay}" />
          <CheckBox Content="{DynamicResource Credentials.Generate.Symbols}"
                    IsChecked="{Binding IncludeSymbols, Mode=TwoWay}" />
        </WrapPanel>
        <Button HorizontalAlignment="Left"
                Content="{DynamicResource Credentials.Generate.Action}"
                Command="{Binding GenerateCommand}" />
      </StackPanel>
    </Border>

    <Border Padding="18" CornerRadius="10"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Spacing="12">
        <TextBlock Classes="section-title" Text="{DynamicResource Credentials.List.Title}" />
        <TextBlock IsVisible="{Binding !HasCredentials}"
                   Text="{DynamicResource Credentials.List.Empty}"
                   TextWrapping="Wrap" />
        <ListBox ItemsSource="{Binding Credentials}"
                 SelectedItem="{Binding SelectedCredential, Mode=TwoWay}"
                 MaxHeight="320">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GeneratedCredentialListItemViewModel">
              <Grid Margin="4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <CheckBox IsEnabled="{Binding CanExport}"
                          IsChecked="{Binding IsSelectedForExport, Mode=TwoWay}" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock FontWeight="SemiBold" Text="{Binding AccountLabel}" TextWrapping="Wrap" />
                  <TextBlock FontSize="12" Text="{Binding StageLabel}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{DynamicResource Credentials.Secret.Concealed}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel IsVisible="{Binding HasSelectedCredential}" Spacing="10">
          <TextBlock Text="{Binding SelectedCredentialStage}" FontWeight="SemiBold" />
          <Border IsVisible="{Binding IsSecretRevealed}"
                  Padding="12"
                  CornerRadius="8"
                  Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <TextBlock FontFamily="Monospace"
                       Text="{Binding RevealedSecret}"
                       TextWrapping="Wrap" />
          </Border>
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="{DynamicResource Credentials.Secret.Reveal}" Command="{Binding RevealCommand}" />
            <Button Content="{DynamicResource Credentials.Secret.Hide}" Command="{Binding HideCommand}" />
            <Button Content="{DynamicResource Credentials.Secret.Copy}" Command="{Binding CopyCommand}" />
            <Button Content="{DynamicResource Credentials.Lifecycle.MarkUsed}" Command="{Binding MarkUsedCommand}" />
            <Button Content="{DynamicResource Credentials.Lifecycle.Confirm}" Command="{Binding ConfirmCredentialCommand}" />
          </WrapPanel>
          <TextBlock IsVisible="{Binding IsClipboardCountdownVisible}"
                     Text="{Binding ClipboardCountdownText}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Padding="18" CornerRadius="10"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Spacing="12">
        <TextBlock Classes="section-title" Text="{DynamicResource Credentials.Export.Title}" />
        <TextBlock Text="{DynamicResource Credentials.Export.Help}" TextWrapping="Wrap" />
        <Border Padding="12" CornerRadius="8"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <TextBlock Text="{DynamicResource Credentials.Export.Warning}" TextWrapping="Wrap" />
        </Border>
        <ComboBox ItemsSource="{Binding Formats}"
                  SelectedItem="{Binding SelectedFormat, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CredentialExportFormatOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBox Text="{Binding DestinationPath, Mode=TwoWay}"
                   PlaceholderText="{DynamicResource Credentials.Export.DestinationPlaceholder}" />
          <Button Grid.Column="1"
                  Content="{DynamicResource Credentials.Export.ChooseDestination}"
                  Click="ChooseDestinationButton_OnClick" />
        </Grid>
        <CheckBox Content="{DynamicResource Credentials.Export.AcknowledgeRisk}"
                  IsChecked="{Binding PlaintextRiskAcknowledged, Mode=TwoWay}" />
        <Button HorizontalAlignment="Left"
                Content="{DynamicResource Credentials.Export.Action}"
                Command="{Binding ExportCommand}" />
        <Button HorizontalAlignment="Left"
                IsVisible="{Binding ExportCommand.IsRunning}"
                Content="{DynamicResource Common.Cancel}"
                Command="{Binding ExportCommand.CancelCommand}" />
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding HasSelectedCredential}"
            Padding="18" CornerRadius="10"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Spacing="12">
        <TextBlock Classes="section-title" Text="{DynamicResource Credentials.Handoff.Title}" />
        <TextBlock Text="{DynamicResource Credentials.Handoff.Help}" TextWrapping="Wrap" />
        <TextBlock IsVisible="{Binding IsImportConfirmationPostponed}"
                   Text="{DynamicResource Credentials.Handoff.PostponedVisible}"
                   TextWrapping="Wrap" />
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Content="{DynamicResource Credentials.Handoff.ConfirmImport}"
                  Command="{Binding ConfirmImportCommand}" />
          <Button Content="{DynamicResource Credentials.Handoff.RevokeImport}"
                  Command="{Binding RevokeImportConfirmationCommand}" />
          <Button Content="{DynamicResource Credentials.Handoff.Postpone}"
                  Command="{Binding PostponeImportConfirmationCommand}" />
          <Button Content="{DynamicResource Credentials.Handoff.ConfirmCleanup}"
                  Command="{Binding ConfirmCleanupCommand}" />
        </WrapPanel>
        <Border IsVisible="{Binding IsCleanupPending}"
                Padding="12" CornerRadius="8"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <TextBlock Text="{DynamicResource Credentials.Handoff.CleanupPending}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding HasSelectedCredential}"
            Padding="18" CornerRadius="10"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <StackPanel Spacing="10">
        <TextBlock Classes="section-title" Text="{DynamicResource Credentials.Delete.Title}" />
        <TextBlock Text="{DynamicResource Credentials.Delete.Disclaimer}" TextWrapping="Wrap" />
        <Button HorizontalAlignment="Left"
                Content="{DynamicResource Credentials.Delete.Action}"
                Command="{Binding DeleteCommand}" />
      </StackPanel>
    </Border>

    <Button HorizontalAlignment="Left"
            Content="{DynamicResource Credentials.Refresh}"
            Command="{Binding RefreshCommand}" />
  </StackPanel>
</UserControl>
