<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Unpwn.App.Presentation"
             x:Class="Unpwn.App.Views.StatusBannerView"
             x:DataType="vm:VisualStatusViewModel">
  <Border Padding="12,10"
          AutomationProperties.AutomationId="status-banner"
          AutomationProperties.LiveSetting="Polite"
          AutomationProperties.Name="{Binding Message}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
          BorderThickness="5,1,1,1"
          CornerRadius="5">
    <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
      <TextBlock Grid.Column="0"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 FontSize="20"
                 FontWeight="Bold"
                 Text="{Binding Symbol}" />
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock FontSize="11"
                   FontWeight="Bold"
                   Text="{Binding KindLabel}" />
        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
        <TextBlock Opacity="0.82" Text="{Binding Message}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
