<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Unpwn.App.Presentation"
             x:Class="Unpwn.App.Views.RecoveryCredentialHandoffView"
             x:DataType="vm:RecoveryCredentialHandoffViewModel"
             IsVisible="{Binding HasCredential}">
  <Border Padding="14"
          CornerRadius="8"
          Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
    <StackPanel Spacing="10">
      <TextBlock FontWeight="SemiBold"
                 Text="{DynamicResource Credentials.InContext.Title}" />
      <TextBlock Text="{DynamicResource Credentials.InContext.Help}"
                 TextWrapping="Wrap" />
      <TextBlock FontWeight="SemiBold"
                 Text="{Binding CredentialStageText}" />

      <Border IsVisible="{Binding IsSecretRevealed}"
              AutomationProperties.AutomationId="workflow-credential-revealed-secret"
              AutomationProperties.LiveSetting="Assertive"
              AutomationProperties.Name="{DynamicResource Credentials.Secret.RevealedAnnouncement}"
              Padding="10"
              CornerRadius="6"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
        <TextBlock FontFamily="Monospace"
                   Text="{Binding RevealedSecret}"
                   TextWrapping="Wrap" />
      </Border>

      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <Button AutomationProperties.AutomationId="workflow-credential-reveal"
                Content="{DynamicResource Credentials.Secret.Reveal}"
                Command="{Binding RevealCommand}" />
        <Button AutomationProperties.AutomationId="workflow-credential-hide"
                Content="{DynamicResource Credentials.Secret.Hide}"
                Command="{Binding HideCommand}" />
        <Button AutomationProperties.AutomationId="workflow-credential-copy"
                Content="{DynamicResource Credentials.Secret.Copy}"
                Command="{Binding CopyCommand}" />
        <Button AutomationProperties.AutomationId="workflow-credential-mark-used"
                Content="{DynamicResource Credentials.Lifecycle.MarkUsed}"
                Command="{Binding MarkUsedCommand}" />
        <Button AutomationProperties.AutomationId="workflow-credential-confirm"
                Content="{DynamicResource Credentials.Lifecycle.Confirm}"
                Command="{Binding ConfirmCredentialCommand}" />
      </WrapPanel>

      <Button IsVisible="{Binding CanUseProviderReviewedAssistance}"
              HorizontalAlignment="Left"
              AutomationProperties.AutomationId="workflow-credential-assisted-insert"
              Content="{DynamicResource Credentials.Assistance.Action}"
              Command="{Binding AssistInsertionCommand}" />

      <TextBlock IsVisible="{Binding IsClipboardCountdownVisible}"
                 AutomationProperties.AutomationId="workflow-credential-clipboard-countdown"
                 AutomationProperties.LiveSetting="Polite"
                 AutomationProperties.Name="{Binding ClipboardCountdownText}"
                 Text="{Binding ClipboardCountdownText}"
                 TextWrapping="Wrap" />

      <TextBlock IsVisible="{Binding HasStatus}"
                 AutomationProperties.AutomationId="workflow-credential-status"
                 AutomationProperties.LiveSetting="Polite"
                 AutomationProperties.Name="{Binding StatusMessage}"
                 Text="{Binding StatusMessage}"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
