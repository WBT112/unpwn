<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Unpwn.App.Presentation"
             xmlns:views="using:Unpwn.App.Views"
             x:Class="Unpwn.App.Views.WorkflowExecutionView"
             x:DataType="vm:WorkflowExecutionScreenViewModel">
  <StackPanel Spacing="20">
    <StackPanel Spacing="8">
      <TextBlock Classes="page-title" Text="{Binding Title}" />
      <TextBlock FontSize="16" Text="{Binding Description}" TextWrapping="Wrap" />
    </StackPanel>

    <views:StatusBannerView DataContext="{Binding Status}" />

    <Border Classes="focus-on-visible"
            IsVisible="{Binding HasValidationMessage}"
            Focusable="True"
            AutomationProperties.AutomationId="workflow-validation"
            AutomationProperties.LiveSetting="Assertive"
            AutomationProperties.Name="{Binding ValidationMessage}"
            Padding="14" CornerRadius="8"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
    </Border>

    <Border IsVisible="{Binding IsGeneralManualWorkflow}"
            Padding="14" CornerRadius="8" BorderThickness="2"
            BorderBrush="{DynamicResource SystemControlErrorTextForegroundBrush}"
            AutomationProperties.Name="{Binding WorkflowTrustTitle}">
      <StackPanel Spacing="5">
        <TextBlock FontWeight="SemiBold" Text="{Binding WorkflowTrustTitle}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding WorkflowTrustMessage}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding IsReviewedProviderWorkflow}"
            Padding="14" CornerRadius="8"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            AutomationProperties.Name="{Binding WorkflowTrustTitle}">
      <StackPanel Spacing="5">
        <TextBlock FontWeight="SemiBold" Text="{Binding WorkflowTrustTitle}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding WorkflowTrustMessage}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding !HasExecution}"
            Padding="18" CornerRadius="10"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Spacing="12">
        <TextBlock Classes="section-title" Text="{DynamicResource Workflow.Path.Automatic.Title}" />
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding AccountName}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding CurrentActionWhyText}" TextWrapping="Wrap" />
        <TextBlock FontWeight="SemiBold" Text="{Binding SelectedPathText}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding PathSelectionReasonText}" TextWrapping="Wrap" />
        <Button HorizontalAlignment="Left"
                Classes="initial-focus"
                AutomationProperties.AutomationId="workflow-begin"
                Content="{DynamicResource Workflow.Path.Start}"
                Command="{Binding StartRecoveryCommand}" />
      </StackPanel>
    </Border>

    <StackPanel IsVisible="{Binding HasExecution}" Spacing="18">
      <StackPanel IsVisible="{Binding IsGuidedActionVisible}" Spacing="18">
        <Grid ColumnDefinitions="2*,*" ColumnSpacing="18">
          <Border x:Name="BrowserWorkspacePanel"
                  Grid.Column="0"
                  IsVisible="{Binding IsBrowserWorkspaceVisible}"
                  MinWidth="340"
                  Focusable="True"
                  Padding="12"
                  CornerRadius="12"
                  BorderThickness="2"
                  BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}"
                  AutomationProperties.AutomationId="workflow-browser-workspace">
            <ContentControl x:Name="BrowserWorkspaceHost" />
          </Border>
        <Border x:Name="CurrentActionCard"
                Grid.Column="{Binding AssistantGridColumn}"
                Grid.ColumnSpan="{Binding AssistantGridColumnSpan}"
                MinWidth="300"
                Focusable="True"
                AutomationProperties.AutomationId="workflow-current-action"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="{Binding CurrentActionTitle}"
                Padding="22" CornerRadius="12"
                BorderThickness="2"
                BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
          <StackPanel Spacing="14">
            <TextBlock Text="{Binding CurrentActionProgressText}" FontWeight="SemiBold" />
            <TextBlock FontSize="14" Text="{Binding AccountName}" TextWrapping="Wrap" />
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding CurrentActionTitle}" TextWrapping="Wrap" />
            <TextBlock FontWeight="SemiBold" Text="{Binding CurrentActionWhyText}" TextWrapping="Wrap" />
            <TextBlock FontSize="16" Text="{Binding CurrentActionInstruction}" TextWrapping="Wrap" />

            <Border Padding="12" CornerRadius="8"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
              <StackPanel Spacing="5">
                <TextBlock FontWeight="SemiBold"
                           Text="{DynamicResource Workflow.Guided.Authentication.Title}" />
                <TextBlock Text="{Binding AuthenticationGuidanceText}"
                           TextWrapping="Wrap" />
                <TextBlock IsVisible="{Binding IsPasswordCredentialAction}"
                           Text="{Binding ReplacementCredentialGuidanceText}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border IsVisible="{Binding HasCurrentActionWarning}"
                    Padding="12" CornerRadius="8"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource SystemControlErrorTextForegroundBrush}">
              <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="{DynamicResource Workflow.Guided.Warning.Title}" />
                <TextBlock Text="{Binding CurrentActionWarning}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <StackPanel Spacing="4">
              <TextBlock FontWeight="SemiBold" Text="{DynamicResource Workflow.Guided.Prerequisites.Title}" />
              <TextBlock Text="{Binding PrerequisitesText}" TextWrapping="Wrap" />
            </StackPanel>

            <Border IsVisible="{Binding HasOfficialLocation}"
                    Padding="14" CornerRadius="8"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
              <StackPanel Spacing="7">
                <TextBlock FontWeight="SemiBold" Text="{Binding NavigationLocationTitle}" />
                <TextBlock Text="{DynamicResource Workflow.Navigation.Destination}" />
                <TextBlock Text="{Binding OfficialLocationText}" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource Workflow.Navigation.ExpectedOrigins}" />
                <TextBlock Text="{Binding ExpectedOriginsText}" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource Workflow.Navigation.Disclaimer}" TextWrapping="Wrap" />
                <Button IsVisible="{Binding HasOfficialLocation}"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="workflow-open-discovered-page"
                        Content="{DynamicResource Workflow.Browser.OpenPrepared}"
                        Command="{Binding OpenRecoveryBrowserCommand}" />
                <Button HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="workflow-open-external-fallback"
                        Content="{DynamicResource Workflow.Browser.ExternalFallback}"
                        Command="{Binding OpenOfficialPageCommand}" />
              </StackPanel>
            </Border>

            <Button IsVisible="{Binding CanGenerateCredentialForCurrentAction}"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="workflow-generate-credential"
                    Content="{DynamicResource Workflow.Guided.Credential.Generate}"
                    Command="{Binding GenerateCredentialCommand}" />
            <TextBlock IsVisible="{Binding HasCredentialReference}"
                       Text="{Binding CredentialReferenceText}"
                       TextWrapping="Wrap" />

            <Button IsVisible="{Binding CanRunGuidedPrimary}"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="workflow-primary-action"
                    Content="{Binding GuidedPrimaryActionText}"
                    Command="{Binding GuidedPrimaryActionCommand}" />

            <Border IsVisible="{Binding IsCurrentActionInProgress}"
                    Padding="14" CornerRadius="8"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
              <StackPanel Spacing="10">
                <TextBlock Classes="section-title" Text="{DynamicResource Workflow.Guided.Completion.Title}" />
                <TextBlock Text="{DynamicResource Workflow.Completion.Help}" TextWrapping="Wrap" />
                <ItemsControl AutomationProperties.AutomationId="workflow-criteria-acknowledge"
                              ItemsSource="{Binding CompletionCriteria}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkflowCompletionCriterionViewModel">
                      <CheckBox Margin="0,3"
                                AutomationProperties.Name="{Binding Text}"
                                Content="{Binding Text}"
                                IsChecked="{Binding IsAcknowledged, Mode=OneWay}"
                                Command="{Binding ToggleCommand}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock AutomationProperties.LiveSetting="Polite"
                           Text="{DynamicResource Workflow.Browser.CriteriaPersistedHelp}"
                           TextWrapping="Wrap" />
                <Button HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="workflow-done"
                        Content="{DynamicResource Workflow.Guided.Done}"
                        Command="{Binding CompleteActionCommand}" />
              </StackPanel>
            </Border>

            <TextBlock IsVisible="{Binding HasNavigationStatus}"
                       AutomationProperties.LiveSetting="Polite"
                       Text="{Binding NavigationStatus}"
                       TextWrapping="Wrap" />

            <Border IsVisible="{Binding HasBrowserLocationProblem}"
                    Padding="14" CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlErrorTextForegroundBrush}"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
              <StackPanel Spacing="10">
                <TextBlock FontWeight="SemiBold"
                           Text="{DynamicResource Workflow.Browser.LocationFallback.Title}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource Workflow.Browser.LocationFallback.Help}"
                           TextWrapping="Wrap" />
                <Button HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="workflow-review-account-details"
                        Content="{DynamicResource Workflow.Browser.LocationFallback.ReviewAccount}"
                        Command="{Binding ReviewAccountDetailsCommand}" />
              </StackPanel>
            </Border>

            <Button IsVisible="{Binding CanReportCurrentProblem}"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="workflow-cannot-continue"
                    Content="{DynamicResource Workflow.Guided.CannotContinue}"
                    Command="{Binding ShowProblemReviewCommand}" />
          </StackPanel>
        </Border>
        </Grid>

        <Border IsVisible="{Binding IsProblemReviewVisible}"
                AutomationProperties.AutomationId="workflow-problem-review"
                Padding="18" CornerRadius="10"
                BorderThickness="2"
                BorderBrush="{DynamicResource SystemControlErrorTextForegroundBrush}"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <StackPanel Spacing="12">
            <TextBlock Classes="section-title" Text="{DynamicResource Workflow.Guided.Problem.Title}" />
            <TextBlock Text="{DynamicResource Workflow.Guided.Problem.Help}" TextWrapping="Wrap" />
            <ComboBox AutomationProperties.AutomationId="workflow-problem-choice"
                      ItemsSource="{Binding ProblemOptions}"
                      SelectedItem="{Binding SelectedProblem, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:GuidedRecoveryProblemOption">
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding SelectedProblemExplanation}" TextWrapping="Wrap" />
            <TextBox Text="{Binding Reason, Mode=TwoWay}"
                     MaxLength="1000"
                     PlaceholderText="{DynamicResource Workflow.Guided.Problem.ReasonPlaceholder}"
                     TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource Workflow.Guided.Problem.ReasonWarning}" TextWrapping="Wrap" />
            <WrapPanel ItemSpacing="10" LineSpacing="10">
              <Button AutomationProperties.AutomationId="workflow-problem-apply"
                      Content="{DynamicResource Workflow.Guided.Problem.Apply}"
                      Command="{Binding ApplyGuidedProblemCommand}" />
              <Button Content="{DynamicResource Workflow.Guided.Problem.Cancel}"
                      Command="{Binding CancelProblemReviewCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Padding="16" CornerRadius="10"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <StackPanel Spacing="10">
            <TextBlock Classes="section-title" Text="{DynamicResource Workflow.Guided.Progress.Title}" />
            <ItemsControl ItemsSource="{Binding Actions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WorkflowActionItemViewModel">
                  <Grid Margin="3" ColumnDefinitions="28,*" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" HorizontalAlignment="Center" FontWeight="Bold" Text="{Binding Symbol}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                      <TextBlock FontSize="12" Text="{Binding Status}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="workflow-show-advanced"
                    Content="{DynamicResource Workflow.Guided.Advanced.Show}"
                    Command="{Binding ShowAdvancedStatusCommand}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel IsVisible="{Binding IsAdvancedStatusVisible}" Spacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Classes="section-title" Text="{DynamicResource Workflow.Guided.Advanced.Title}" />
            <TextBlock Text="{DynamicResource Workflow.Guided.Advanced.Help}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1"
                  AutomationProperties.AutomationId="workflow-show-guided"
                  Content="{DynamicResource Workflow.Guided.Advanced.Back}"
                  Command="{Binding ShowGuidedActionCommand}" />
        </Grid>

        <Border Padding="18" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
          <StackPanel Spacing="10">
            <TextBlock Classes="section-title" Text="{DynamicResource Workflow.Account.Title}" />
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding AccountName}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="7">
              <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="{DynamicResource Workflow.Account.Category}" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CategoryText}" />
              <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="{DynamicResource Workflow.Account.CategoryDecision}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CategoryDecisionText}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="{DynamicResource Workflow.Account.Workflow}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WorkflowIndependenceText}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="{DynamicResource Workflow.Account.Access}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AccessStateText}" />
              <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="{DynamicResource Workflow.Account.Status}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RecoveryStatusText}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Padding="18" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
          <StackPanel Spacing="10">
            <TextBlock Classes="section-title" Text="{DynamicResource Workflow.Path.Automatic.Title}" />
            <TextBlock FontWeight="SemiBold" Text="{Binding SelectedPathText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PathSelectionReasonText}" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource Workflow.Path.Automatic.Help}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Padding="18" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
          <StackPanel Spacing="10">
            <TextBlock Classes="section-title" Text="{DynamicResource Workflow.Access.Title}" />
            <TextBlock Text="{Binding AccessReasonText}" TextWrapping="Wrap" />
            <TextBox Text="{Binding Reason, Mode=TwoWay}" MaxLength="1000" PlaceholderText="{DynamicResource Workflow.Reason.Placeholder}" TextWrapping="Wrap" />
            <WrapPanel ItemSpacing="10" LineSpacing="10">
              <Button Content="{DynamicResource Workflow.Access.Available.Action}" Command="{Binding SetAccessAvailableCommand}" />
              <Button Content="{DynamicResource Workflow.Access.WaitingForProviderReview.Action}" Command="{Binding SetWaitingCommand}" />
              <Button Content="{DynamicResource Workflow.Access.Lost.Action}" Command="{Binding SetAccessLostCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="300,*" ColumnSpacing="18">
          <Border Grid.Column="0" Padding="12" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <StackPanel Spacing="10">
              <TextBlock Classes="section-title" Text="{DynamicResource Workflow.Actions.Title}" />
              <ListBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction, Mode=TwoWay}" MinHeight="360">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:WorkflowActionItemViewModel">
                    <Grid Margin="3" ColumnDefinitions="28,*" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" HorizontalAlignment="Center" FontWeight="Bold" Text="{Binding Symbol}" />
                      <StackPanel Grid.Column="1" Spacing="2"><TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" /><TextBlock FontSize="12" Text="{Binding Status}" TextWrapping="Wrap" /></StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="1" Spacing="16">
            <Border Padding="18" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
              <StackPanel Spacing="8">
                <TextBlock Classes="section-title" Text="{Binding CurrentActionTitle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CurrentActionInstruction}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CurrentActionImportanceText}" />
                <TextBlock Text="{Binding CurrentActionAutomationText}" />
                <TextBlock FontWeight="SemiBold" Text="{DynamicResource Workflow.Action.Prerequisites}" />
                <TextBlock Text="{Binding PrerequisitesText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding RecordedReasonText}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
              <StackPanel Spacing="10">
                <TextBlock Classes="section-title" Text="{DynamicResource Workflow.Notes.Title}" />
                <TextBlock Text="{DynamicResource Workflow.Notes.Warning}" TextWrapping="Wrap" />
                <TextBox Text="{Binding Notes, Mode=TwoWay}" MaxLength="4000" MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CredentialReferenceText}" TextWrapping="Wrap" />
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <Button Content="{DynamicResource Workflow.Credential.Generate}" Command="{Binding GenerateCredentialCommand}" />
                  <Button Content="{DynamicResource Workflow.Notes.Save}" Command="{Binding SaveNotesCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Padding="18" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
              <StackPanel Spacing="10">
                <TextBlock Classes="section-title" Text="{DynamicResource Workflow.Outcome.Title}" />
                <TextBox Text="{Binding Reason, Mode=TwoWay}" MaxLength="1000" PlaceholderText="{DynamicResource Workflow.Reason.Placeholder}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding CompletionCriteria}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkflowCompletionCriterionViewModel">
                      <CheckBox Content="{Binding Text}"
                                IsChecked="{Binding IsAcknowledged, Mode=OneWay}"
                                Command="{Binding ToggleCommand}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <Button Content="{DynamicResource Workflow.Action.Start}" Command="{Binding StartActionCommand}" />
                  <Button Content="{DynamicResource Workflow.Action.Retry}" Command="{Binding RetryActionCommand}" />
                  <Button Content="{DynamicResource Workflow.Action.Complete}" Command="{Binding CompleteActionCommand}" />
                  <Button Content="{DynamicResource Workflow.Action.NeedsUserAction}" Command="{Binding RequireUserActionCommand}" />
                  <Button Content="{DynamicResource Workflow.Action.Block}" Command="{Binding BlockActionCommand}" />
                  <Button Content="{DynamicResource Workflow.Action.Fail}" Command="{Binding FailActionCommand}" />
                  <Button Content="{DynamicResource Workflow.Action.NotApplicable}" Command="{Binding MarkNotApplicableCommand}" />
                  <Button Content="{DynamicResource Workflow.Action.AcceptRisk}" Command="{Binding AcceptRiskCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
