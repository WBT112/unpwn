<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Unpwn.App.Presentation"
             xmlns:views="using:Unpwn.App.Views"
             x:Class="Unpwn.App.Views.CompletionScreenView"
             x:DataType="vm:CompletionScreenViewModel">
  <StackPanel Spacing="22">
    <StackPanel Spacing="8">
      <TextBlock Classes="page-title" Text="{Binding Title}" />
      <TextBlock FontSize="16" Text="{Binding Description}" TextWrapping="Wrap" />
    </StackPanel>

    <views:StatusBannerView DataContext="{Binding Status}" />

    <Border Padding="20"
            CornerRadius="8"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Spacing="12">
        <TextBlock Classes="section-title" Text="{DynamicResource Completion.Section.Title}" />
        <TextBlock Text="{DynamicResource Completion.Section.Description}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="initial-focus"
                  AutomationProperties.AutomationId="completion-review"
                  Command="{Binding ReviewCompletionCommand}"
                  Content="{DynamicResource Completion.Review.Button}" />
          <Button IsVisible="{Binding ReviewCompletionCommand.IsRunning}"
                  Command="{Binding ReviewCompletionCommand.CancelCommand}"
                  Content="{DynamicResource Common.Cancel}" />
          <ProgressBar Width="120"
                       IsIndeterminate="True"
                       IsVisible="{Binding ReviewCompletionCommand.IsRunning}" />
        </StackPanel>
        <TextBlock IsVisible="{Binding !HasUnlockedVault}"
                   Opacity="0.75"
                   Text="{DynamicResource Completion.UnlockHint}" />
      </StackPanel>
    </Border>

    <Grid IsVisible="{Binding HasReview}" ColumnDefinitions="*,*" ColumnSpacing="16">
      <Border Grid.Column="0" Padding="16" BorderThickness="1" CornerRadius="8"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="Bold" Text="{DynamicResource Completion.Summary.Title}" />
          <TextBlock Text="{Binding AccountsSummary}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CriticalSummary}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ActionSummary}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CredentialSummary}" TextWrapping="Wrap" />
          <TextBlock FontWeight="Bold"
                     Text="{DynamicResource Completion.NoSafetyClaim}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Padding="16" BorderThickness="1" CornerRadius="8"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="Bold" Text="{DynamicResource Completion.Report.Title}" />
          <TextBlock Text="{DynamicResource Completion.Report.Description}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     IsReadOnly="True"
                     Text="{Binding DestinationPath}"
                     PlaceholderText="{DynamicResource Completion.Export.PathWatermark}" />
            <Button Grid.Column="1"
                    Click="ChooseReportDestinationButton_OnClick"
                    Content="{DynamicResource Completion.Export.Choose}" />
          </Grid>
          <Button HorizontalAlignment="Left"
                  Command="{Binding ExportReportCommand}"
                  Content="{DynamicResource Completion.Export.Button}" />
        </StackPanel>
      </Border>
    </Grid>

    <Border IsVisible="{Binding HasReview}"
            Padding="20"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <StackPanel Spacing="12">
        <TextBlock Classes="section-title" Text="{DynamicResource Completion.Issues.Title}" />
        <TextBlock IsVisible="{Binding IsClean}"
                   Text="{DynamicResource Completion.Issues.None}" />
        <ItemsControl ItemsSource="{Binding Issues}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecoveryCompletionIssueViewModel">
              <Border Padding="10" Margin="0,0,0,8" BorderThickness="5,1,1,1" CornerRadius="5"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock FontWeight="Bold" Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                    <TextBlock FontWeight="Bold" Text="{Binding Severity}" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          VerticalAlignment="Center"
                          Command="{Binding NavigateCommand}"
                          Content="{DynamicResource Completion.Issue.Open}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button IsVisible="{Binding !IsReadOnly}"
                HorizontalAlignment="Left"
                Command="{Binding OpenCredentialsCommand}"
                Content="{DynamicResource Completion.Credentials.Open}" />
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding HasReview}"
            Padding="20"
            CornerRadius="8"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Spacing="12">
        <TextBlock Classes="section-title" Text="{DynamicResource Completion.Decision.Title}" />
        <TextBlock IsVisible="{Binding IsReadOnly}"
                   Text="{DynamicResource Completion.ReadOnly.Guidance}"
                   TextWrapping="Wrap" />
        <CheckBox AutomationProperties.AutomationId="completion-accept-risks"
                  IsVisible="{Binding RequiresRiskAcceptance}"
                  IsEnabled="{Binding !IsReadOnly}"
                  IsChecked="{Binding AcceptUnresolvedRisks}"
                  Content="{DynamicResource Completion.AcceptRisks}" />
        <TextBlock IsVisible="{Binding RequiresRiskAcceptance}"
                   Text="{DynamicResource Completion.AcceptRisks.Detail}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{DynamicResource Completion.Credentials.RetainNotice}" TextWrapping="Wrap" />
        <StackPanel IsVisible="{Binding !IsReadOnly}" Orientation="Horizontal" Spacing="10">
          <Button AutomationProperties.AutomationId="completion-complete"
                  Command="{Binding CompleteCommand}"
                  Content="{DynamicResource Completion.Complete.Button}" />
          <Button Command="{Binding ArchiveCommand}"
                  Content="{DynamicResource Completion.Archive.Button}" />
          <Button IsVisible="{Binding CompleteCommand.IsRunning}"
                  Command="{Binding CompleteCommand.CancelCommand}"
                  Content="{DynamicResource Common.Cancel}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
