<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Unpwn.App.Presentation"
             xmlns:views="using:Unpwn.App.Views"
             x:Class="Unpwn.App.Views.CompletionScreenView"
             x:DataType="vm:CompletionScreenViewModel">
  <StackPanel Spacing="22">
    <StackPanel Spacing="8">
      <TextBlock Classes="page-title" Text="{Binding Title}" />
      <TextBlock FontSize="16" Text="{Binding Description}" TextWrapping="Wrap" />
    </StackPanel>

    <views:StatusBannerView DataContext="{Binding Status}" />

    <Border Padding="20"
            CornerRadius="8"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <StackPanel Spacing="12">
        <TextBlock Classes="section-title" Text="Sensitive confirmation foundation" />
        <TextBlock Text="The confirmation names the exact action and affected recovery session. Functional completion remains out of scope."
                   TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button TabIndex="3"
                  Command="{Binding ReviewCompletionCommand}"
                  Content="Review completion confirmation" />
          <Button TabIndex="4"
                  IsVisible="{Binding ReviewCompletionCommand.IsRunning}"
                  Command="{Binding ReviewCompletionCommand.CancelCommand}"
                  Content="Cancel" />
          <ProgressBar Width="120"
                       IsIndeterminate="True"
                       IsVisible="{Binding ReviewCompletionCommand.IsRunning}" />
        </StackPanel>
        <TextBlock IsVisible="{Binding !HasUnlockedVault}"
                   Opacity="0.75"
                   Text="Unlock a vault before reviewing session completion." />
        <Border IsVisible="{Binding ReviewCompletionCommand.HasError}"
                Padding="10"
                BorderBrush="#B3261E"
                BorderThickness="5,1,1,1"
                CornerRadius="5">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock FontWeight="Bold" Text="× FAILED" />
            <TextBlock Text="{Binding ReviewCompletionCommand.LastErrorMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
