<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Unpwn.App.Presentation"
             xmlns:views="using:Unpwn.App.Views"
             x:Class="Unpwn.App.Views.CompletionScreenView"
             x:DataType="vm:CompletionScreenViewModel">
  <StackPanel Spacing="22">
    <StackPanel Spacing="8">
      <TextBlock Classes="page-title" Text="{Binding Title}" />
      <TextBlock FontSize="16" Text="{Binding Description}" TextWrapping="Wrap" />
    </StackPanel>
    <views:StatusBannerView DataContext="{Binding Status}" />

    <Border IsVisible="{Binding ReviewCompletionCommand.IsRunning}" Classes="passive-information"
            AutomationProperties.AutomationId="completion-loading"
            AutomationProperties.LiveSetting="Polite">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <ProgressBar Width="120" IsIndeterminate="True" />
        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Completion.AutoReview.Loading}" />
      </StackPanel>
    </Border>
    <Border IsVisible="{Binding !HasUnlockedVault}" Classes="actionable-warning">
      <TextBlock Text="{DynamicResource Completion.UnlockHint}" TextWrapping="Wrap" />
    </Border>

    <Border IsVisible="{Binding HasIssues}" Classes="actionable-warning"
            AutomationProperties.AutomationId="completion-before-finish">
      <StackPanel Spacing="12">
        <TextBlock Classes="section-title" Text="{DynamicResource Completion.BeforeFinish.Title}" />
        <TextBlock Text="{DynamicResource Completion.BeforeFinish.Help}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Issues}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecoveryCompletionIssueViewModel">
              <Border Padding="10" Margin="0,0,0,8" BorderThickness="0,0,0,1"
                      BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock FontWeight="Bold" Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding Severity}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="secondary" VerticalAlignment="Center"
                          Command="{Binding NavigateCommand}" Content="{DynamicResource Completion.Issue.Open}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button IsVisible="{Binding !IsReadOnly}" Classes="secondary" HorizontalAlignment="Left"
                Command="{Binding OpenCredentialsCommand}" Content="{DynamicResource Completion.Credentials.Open}" />
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding HasReview}" Padding="22" CornerRadius="10"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
            AutomationProperties.AutomationId="completion-decision">
      <StackPanel Spacing="12">
        <TextBlock Classes="section-title" Text="{DynamicResource Completion.Decision.Title}" />
        <TextBlock IsVisible="{Binding IsClean}" Text="{DynamicResource Completion.Issues.None}" TextWrapping="Wrap" />
        <TextBlock IsVisible="{Binding IsReadOnly}" Text="{DynamicResource Completion.ReadOnly.Guidance}" TextWrapping="Wrap" />
        <CheckBox AutomationProperties.AutomationId="completion-accept-risks"
                  IsVisible="{Binding RequiresRiskAcceptance}" IsEnabled="{Binding !IsReadOnly}"
                  IsChecked="{Binding AcceptUnresolvedRisks}"
                  Content="{DynamicResource Completion.AcceptRisks}" />
        <TextBlock IsVisible="{Binding RequiresRiskAcceptance}"
                   Text="{DynamicResource Completion.AcceptRisks.Detail}" TextWrapping="Wrap" />
        <TextBlock Text="{DynamicResource Completion.NoSafetyClaim}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <Button Classes="primary initial-focus" IsVisible="{Binding !IsReadOnly}"
                AutomationProperties.AutomationId="completion-complete"
                HorizontalAlignment="Left" Command="{Binding CompleteCommand}"
                Content="{DynamicResource Completion.Complete.Button}" />
      </StackPanel>
    </Border>

    <Expander IsVisible="{Binding HasReview}" Classes="details"
              AutomationProperties.AutomationId="completion-details"
              Header="{DynamicResource Completion.Details.Title}">
      <StackPanel Margin="0,12,0,0" Spacing="14">
        <TextBlock Text="{Binding AccountsSummary}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding CriticalSummary}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ActionSummary}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding CredentialSummary}" TextWrapping="Wrap" />
        <TextBlock FontWeight="Bold" Text="{DynamicResource Completion.NoSafetyClaim}" TextWrapping="Wrap" />
        <TextBlock Classes="section-title" Text="{DynamicResource Completion.Report.Title}" />
        <TextBlock Text="{DynamicResource Completion.Report.Description}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox IsReadOnly="True" Text="{Binding DestinationPath}"
                   PlaceholderText="{DynamicResource Completion.Export.PathWatermark}" />
          <Button Grid.Column="1" Classes="secondary" Click="ChooseReportDestinationButton_OnClick"
                  Content="{DynamicResource Completion.Export.Choose}" />
        </Grid>
        <Button Classes="secondary" HorizontalAlignment="Left" Command="{Binding ExportReportCommand}"
                Content="{DynamicResource Completion.Export.Button}" />
        <Expander IsVisible="{Binding !IsReadOnly}" Classes="details"
                  Header="{DynamicResource Completion.SessionManagement.Title}">
          <StackPanel Margin="0,8,0,0" Spacing="8">
            <TextBlock Text="{DynamicResource Completion.SessionManagement.Help}" TextWrapping="Wrap" />
            <Button Classes="destructive" HorizontalAlignment="Left" Command="{Binding ArchiveCommand}"
                    Content="{DynamicResource Completion.Archive.Button}" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
