<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:Unpwn.App.Services"
        x:Class="Unpwn.App.Views.ConfirmationDialog"
        x:DataType="services:SensitiveConfirmationRequest"
        Title="Confirm sensitive action"
        Width="520"
        Height="330"
        MinWidth="420"
        MinHeight="300"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="*,Auto" RowSpacing="20">
    <StackPanel Grid.Row="0" Spacing="12">
      <TextBlock Classes="page-title" Text="Confirm action" />
      <Border Padding="14"
              BorderBrush="#B26A00"
              BorderThickness="5,1,1,1"
              CornerRadius="5">
        <StackPanel Spacing="8">
          <TextBlock FontSize="12" FontWeight="Bold" Text="{Binding RiskLabel}" />
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Action}" TextWrapping="Wrap" />
          <TextBlock FontSize="12" FontWeight="Bold" Text="AFFECTED ITEM" />
          <TextBlock Text="{Binding AffectedItem}" TextWrapping="Wrap" />
          <TextBlock FontSize="12" FontWeight="Bold" Text="CONSEQUENCE" />
          <TextBlock Text="{Binding Consequence}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel Grid.Row="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
      <Button TabIndex="0" Click="CancelButton_OnClick" Content="Cancel" />
      <Button TabIndex="1"
              Click="ConfirmButton_OnClick"
              Content="{Binding ConfirmLabel}" />
    </StackPanel>
  </Grid>
</Window>
