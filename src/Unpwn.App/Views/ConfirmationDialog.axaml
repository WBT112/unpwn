<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:Unpwn.App.Services"
        x:Class="Unpwn.App.Views.ConfirmationDialog"
        x:DataType="services:SensitiveConfirmationRequest"
        Title="{DynamicResource Confirmation.WindowTitle}"
        Width="520"
        Height="330"
        MinWidth="420"
        MinHeight="300"
        CanResize="False"
        ShowInTaskbar="False"
        KeyDown="Window_OnKeyDown"
        Opened="Window_OnOpened"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="*,Auto" RowSpacing="20">
    <StackPanel Grid.Row="0" Spacing="12">
      <TextBlock Classes="page-title" Text="{DynamicResource Confirmation.PageTitle}" />
      <Border Padding="14"
              AutomationProperties.AutomationId="confirmation-risk-summary"
              AutomationProperties.LiveSetting="Assertive"
              AutomationProperties.Name="{Binding Consequence}"
              BorderBrush="{DynamicResource SystemControlErrorTextForegroundBrush}"
              BorderThickness="5,1,1,1"
              CornerRadius="5">
        <StackPanel Spacing="8">
          <TextBlock FontSize="12" FontWeight="Bold" Text="{Binding RiskLabel}" />
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Action}" TextWrapping="Wrap" />
          <TextBlock FontSize="12" FontWeight="Bold" Text="{DynamicResource Confirmation.AffectedItem}" />
          <TextBlock Text="{Binding AffectedItem}" TextWrapping="Wrap" />
          <TextBlock FontSize="12" FontWeight="Bold" Text="{DynamicResource Confirmation.Consequence}" />
          <TextBlock Text="{Binding Consequence}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
    <StackPanel Grid.Row="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
      <Button x:Name="CancelButton"
              TabIndex="0"
              AutomationProperties.AutomationId="confirmation-cancel"
              Click="CancelButton_OnClick"
              Content="{DynamicResource Common.Cancel}" />
      <Button TabIndex="1"
              AutomationProperties.AutomationId="confirmation-confirm"
              Click="ConfirmButton_OnClick"
              Content="{Binding ConfirmLabel}" />
    </StackPanel>
  </Grid>
</Window>
