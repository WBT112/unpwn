<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Unpwn.App.Converters"
             xmlns:vm="using:Unpwn.App.Presentation"
             xmlns:views="using:Unpwn.App.Views"
             x:Class="Unpwn.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <converters:StatusStateBrushConverter x:Key="StatusStateBrushConverter" />
    <x:Double x:Key="ShellSpacingSmall">8</x:Double>
    <x:Double x:Key="ShellSpacingMedium">16</x:Double>
    <x:Double x:Key="ShellSpacingLarge">24</x:Double>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type vm:VaultEntryScreenViewModel}">
      <views:VaultEntryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DashboardScreenViewModel}">
      <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AccountInventoryScreenViewModel}">
      <views:AccountsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CompletionScreenViewModel}">
      <views:CompletionScreenView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CsvImportScreenViewModel}">
      <views:CsvImportView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PlaceholderScreenViewModel}">
      <views:PlaceholderScreenView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button:focus-visible">
      <Setter Property="BorderBrush" Value="#1A73E8" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="ComboBox:focus-visible">
      <Setter Property="BorderBrush" Value="#1A73E8" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="ListBoxItem:focus-visible">
      <Setter Property="BorderBrush" Value="#1A73E8" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="TextBox:focus-visible">
      <Setter Property="BorderBrush" Value="#1A73E8" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>

    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Styles>
</Application>
