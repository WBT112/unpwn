<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Unpwn.App.Presentation"
             xmlns:views="using:Unpwn.App.Views"
             x:Class="Unpwn.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <x:Double x:Key="ShellSpacingSmall">8</x:Double>
    <x:Double x:Key="ShellSpacingMedium">16</x:Double>
    <x:Double x:Key="ShellSpacingLarge">24</x:Double>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type vm:VaultEntryScreenViewModel}">
      <views:VaultEntryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DashboardScreenViewModel}">
      <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AccountInventoryScreenViewModel}">
      <views:AccountsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:WorkflowExecutionScreenViewModel}">
      <views:WorkflowExecutionView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CredentialExportScreenViewModel}">
      <views:CredentialExportView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CompletionScreenViewModel}">
      <views:CompletionScreenView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CsvImportScreenViewModel}">
      <views:CsvImportView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundChromeWhiteBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tertiary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Button.destructive">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="ComboBox:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="ListBoxItem:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="TextBox:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="CheckBox:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="NumericUpDown:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>

    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.passive-information">
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    </Style>
    <Style Selector="Border.actionable-warning">
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      <Setter Property="BorderThickness" Value="5,1,1,1" />
    </Style>
    <Style Selector="Expander.details">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </Application.Styles>
</Application>
