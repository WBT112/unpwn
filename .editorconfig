root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0055.severity = warning

[*.{axaml,csproj,props,slnx,targets,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# These stateful services intentionally keep explicit constructors so dependency
# validation, optional shared-coordinator ownership, and disposal semantics remain
# visible rather than being hidden in field initializers.
[src/Unpwn.App/Services/RecoverySessionService.cs]
dotnet_diagnostic.IDE0290.severity = none

[src/Unpwn.App/Services/AccountInventoryService.cs]
dotnet_diagnostic.IDE0290.severity = none
dotnet_diagnostic.IDE0305.severity = none

[src/Unpwn.App/Services/WorkspacePersistenceContracts.cs]
dotnet_diagnostic.IDE0290.severity = none
